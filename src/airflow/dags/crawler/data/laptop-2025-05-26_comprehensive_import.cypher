MERGE (l:Laptop {productId: '/laptop/hp-omen-14-fb0135tx-ultra-7-ay8v1pa'}) SET l.name = 'hp-omen-14-fb0135tx-ultra-7-ay8v1pa', l.url = 'https://www.thegioididong.com/laptop/hp-omen-14-fb0135tx-ultra-7-ay8v1pa', l.description = 'Tạo hình độc đáo cho một chiếc laptop gaming kết hợp ultrabook với thiết kế mỏng gọn, sang trọng nhưng lại sở hữu cấu hình siêu phàm dành cho dân chuyên. Laptop HP OMEN Transcend 14 fb0135TX Ultra 7 155H (AY8V1PA) đáp ứng hoàn hảo các tựa game đình đám, các file xử lý đồ hoạ chuyên sâu. \"Sảng khoái\" chiến mọi tựa game Đưa bạn vào thế giới gaming ấn tượng Âm thanh sống động, webcam sắc nét Thanh lịch nhưng đầy mạnh mẽ Kết nối đa dạng, pin trâu Tâm điểm của HP OMEN Transcend 14 nằm ở bộ vi xử lý Intel Core Ultra 7 155H thế hệ Ultra mới mẻ với nhân AI hoàn toàn mới. Sở hữu 16 nhân và 22 luồng, bộ vi xử lý này không chỉ mạnh mẽ trong các tác vụ cơ bản mà còn thể hiện sự xuất sắc khi chạy các ứng dụng nặng như xử lý AI hay render đồ họa phức tạp. Xung nhịp có thể tăng tốc lên đến 4.8 GHz nhờ Turbo Boost, đảm bảo hiệu năng ổn định và mượt mà trong mọi hoàn cảnh dù chiến game AAA hay chỉ là xử lý tác vụ thông thường. Chiếc laptop này còn được trang bị card đồ họa rời NVIDIA GeForce RTX 4060 8 GB một trong những dòng card đồ họa cao cấp nhất hiện nay. Công nghệ Ray Tracing hiện đại cho phép xử lý ánh sáng và bóng đổ chân thực, mang đến trải nghiệm đồ họa cao cấp, nịnh mắt trong các tựa game AAA như Red Dead Redemption 2 hay The Witcher 3,... Bên cạnh đó, RAM 16 GB LPDDR5X hoạt động ở tốc độ 7467 MHz giúp hỗ trợ đa nhiệm hiệu quả. Dung lượng bộ nhớ tạm lớn nên bạn có thể mở nhiều ứng dụng cùng lúc mà không gặp tình trạng giật lag. Ổ cứng SSD 1 TB M.2 PCIe NVMe cũng là điểm nhấn khô', l.launchYear = 2024, l.currentPrice = 58990000.0, l.currentPriceText = '58.990.000₫ *', l.originalPriceText = '65.990.000₫', l.discountPercentageText = '-10%'
