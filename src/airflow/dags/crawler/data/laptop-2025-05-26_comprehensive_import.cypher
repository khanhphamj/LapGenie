MERGE (l:Laptop {productId: '/laptop/lenovo-ideapad-slim-3-15irh10-i5-83k1000hvn'}) SET l.name = 'lenovo-ideapad-slim-3-15irh10-i5-83k1000hvn', l.url = 'https://www.thegioididong.com/laptop/lenovo-ideapad-slim-3-15irh10-i5-83k1000hvn', l.description = 'Laptop Lenovo IdeaPad Slim 3 15IRH10 i5 13420H (83K1000HVN) là sự lựa chọn lý tưởng cho học sinh, sinh viên và nhân viên văn phòng nhờ sự kết hợp hoàn hảo giữa hiệu năng ổn định, thiết kế mỏng nhẹ và tính di động cao. Đây là người bạn đồng hành đáng tin cậy, đáp ứng tốt mọi nhu cầu từ học tập, làm việc đến giải trí, mang đến trải nghiệm sử dụng tuyệt vời trong tầm giá. Sức mạnh vượt trội, cân mọi tác vụ với chip Intel Core i5 thế hệ 13 Màn hình lớn sắc nét, trải nghiệm hình ảnh sống động Âm thanh sống động, webcam sắc nét Thiết kế mỏng nhẹ, độ bền chuẩn quân đội Kết nối đa dạng, thời lượng pin ấn tượng \"Trái tim\" của chiếc laptop học tập - văn phòng này là bộ vi xử lý Intel Core i5 Raptor Lake - 13420H với 8 nhân và 12 luồng, tốc độ tối đa lên đến 4.6 GHz nhờ Turbo Boost. Sức mạnh này cho phép máy xử lý mượt mà các tác vụ văn phòng hàng ngày như soạn thảo văn bản, duyệt web, làm việc với bảng tính, cũng như các ứng dụng đồ họa nhẹ và giải trí đa phương tiện. Card đồ họa tích hợp Intel UHD Graphics cũng đủ sức đáp ứng nhu cầu xem phim, chơi game online nhẹ nhàng. Máy được trang bị sẵn 16 GB RAM DDR5 2 khe (1 khe 8 GB onboard + 1 khe 8 GB) tốc độ 4800 MHz, giúp bạn thoải mái mở nhiều tab trình duyệt, chạy nhiều ứng dụng cùng lúc mà không lo giật lag. Ổ cứng 512 GB SSD NVMe PCIe 4.0 không chỉ cung cấp không gian lưu trữ rộng rãi cho tài liệu, hình ảnh, video mà còn giúp máy khởi động nhanh chóng, truy xuất dữ liệu tức thì. Lenovo IdeaPad Slim 3 15IRH10 sở hữu màn hình 15.3 inc', l.launchYear = 2024, l.currentPrice = 16190000.000000002, l.currentPriceText = '16.190.000₫', l.originalPriceText = '16.490.000₫', l.discountPercentageText = ''
