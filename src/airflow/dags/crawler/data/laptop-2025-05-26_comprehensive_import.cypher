MERGE (l:Laptop {productId: '/laptop/hp-envy-x360-14-fc0153tu-ultra-7-ay8v4pa?utm_flashsale=1'}) SET l.name = 'hp-envy-x360-14-fc0153tu-ultra-7-ay8v4pa?utm_flashsale=1', l.url = 'https://www.thegioididong.com/laptop/hp-envy-x360-14-fc0153tu-ultra-7-ay8v4pa?utm_flashsale=1', l.description = 'Laptop HP Envy X360 14 fc0153TU Ultra 7 155U (AY8V4PA) vừa sở hữu ngoại hình \"nịnh mắt\", sang trọng, cấu hình mạnh mẽ, màn hình 2.8K sắc nét cùng nhiều tính năng và tiện ích tân tiến khác. Sản phẩm có thể nói là hội tụ đầy đủ nhất những gì trên một chiếc ultrabook thuộc phân khúc cao cấp. • Laptop HP Envy sở hữu cân nặng chỉ vỏn vẹn 1.39 kg mặc dù khung máy và vỏ được chế tác hoàn toàn từ kim loại cao cấp, chất liệu này mang lại tổng thể cứng cáp, không bị tình trạng ọp ẹp xuất hiện ở các bề mặt của sản phẩm và cũng vô cùng dễ dàng để mang theo bên mình. • Ngoại hình \"sang chảnh\" cùng bản lề linh hoạt của HP Envy X360 cho phép xoay gập 360 độ, dễ dàng chuyển đổi giữa chế độ laptop và tablet để đáp ứng mọi nhu cầu sử dụng từ công việc đến giải trí. Ngoài ra, khi kết hợp bút cảm ứng đi kèm cũng rất tiện dụng trong các tình huống ghi note, vẽ phác thảo nhanh ý tưởng. • Bàn phím của laptop được thiết kế với độ nảy tốt, kết hợp với đèn nền giúp bạn dễ dàng làm việc ngay cả trong điều kiện thiếu sáng. Một số tiện ích khác có thể kể đến như tính năng mở khoá khuôn mặt an toàn, công tắc khóa camera cho phép đóng mở thủ công webcam khi không dùng nữa để tránh lộ hình ảnh cá nhân. • Dù được hoàn thiện với cấu trúc nhỏ gọn nhưng HP Envy X360 vẫn trang bị đầy đủ các cổng kết nối cần thiết như HDMI, USB Type-A, headphone/microphone combo, USB Type-C và Thunderbolt 4 hỗ trợ liên kết dễ dàng tới hầu hết các thiết bị ngoại vi mà không phải sắm thêm chiếc Hub chuyển đổi. • Màn hình LED UW', l.launchYear = 2024, l.currentPrice = 34590000.0, l.currentPriceText = '34.590.000₫ *', l.originalPriceText = '35.990.000₫', l.discountPercentageText = ''
