MERGE (l:Laptop {productId: '/laptop/lenovo-loq-15irx9-i5-83dv003cvn'}) SET l.name = 'lenovo-loq-15irx9-i5-83dv003cvn', l.url = 'https://www.thegioididong.com/laptop/lenovo-loq-15irx9-i5-83dv003cvn', l.description = 'Lenovo LOQ 15IRX9 là chiếc laptop gaming mạnh mẽ, được thiết kế dành cho các nhà thiết kế đồ họa, dựng video và người làm kỹ thuật chuyên nghiệp. Với hiệu năng vượt trội, màn hình sắc nét và các tính năng hỗ trợ tối ưu, chiếc laptop này sẽ là công cụ đắc lực giúp bạn hoàn thành mọi tác vụ một cách hiệu quả. Đây là sự lựa chọn đáng giá cho những ai tìm kiếm một chiếc Laptop Lenovo LOQ 15IRX9 i5 13450HX (83DV003CVN) để phục vụ cho công việc và giải trí. Sức mạnh vượt trội cho mọi tác vụ Màn hình sắc nét, hiển thị sống động Âm thanh sống động và các tính năng hỗ trợ khác Thiết kế mạnh mẽ, độ bền ấn tượng Kết nối đa dạng, pin đủ dùng Lenovo LOQ 15IRX9 được trang bị bộ vi xử lý Intel Core i5 13450HX mạnh mẽ với 10 nhân và 16 luồng, tốc độ xung nhịp lên đến 4.6 GHz nhờ Turbo Boost, giúp bạn dễ dàng xử lý các tác vụ nặng như thiết kế đồ họa, dựng video, render 3D và chơi các tựa game AAA một cách mượt mà. Bạn có thể thoải mái chiến các tựa game như Cyberpunk 2077, Assassin\\\'s Creed Valhalla hay Forza Horizon 5 với cấu hình này. Card đồ họa NVIDIA GeForce RTX 3050 6 GB cho phép bạn thỏa sức sáng tạo với các phần mềm thiết kế chuyên nghiệp và tận hưởng trải nghiệm gaming tuyệt vời. Laptop kỹ thuật này đi kèm với 16 GB RAM DDR5 4800 MHz, cho khả năng đa nhiệm mượt mà, bạn có thể mở nhiều ứng dụng cùng lúc mà không lo bị giật lag. Ổ cứng 512 GB SSD NVMe PCIe 4.0 giúp bạn khởi động máy và mở ứng dụng cực nhanh, đồng thời có thể nâng cấp lên tối đa 1 TB để thoải mái lưu trữ dữ liệu. Lap', l.launchYear = 2024, l.currentPrice = 22190000.0, l.currentPriceText = '22.190.000₫ *', l.originalPriceText = '24.990.000₫', l.discountPercentageText = '-11%'
