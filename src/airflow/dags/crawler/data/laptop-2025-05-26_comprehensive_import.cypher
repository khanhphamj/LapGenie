MERGE (l:Laptop {productId: '/laptop/msi-katana-a15-ai-b8vg-r7-465vn'}) SET l.name = 'msi-katana-a15-ai-b8vg-r7-465vn', l.url = 'https://www.thegioididong.com/laptop/msi-katana-a15-ai-b8vg-r7-465vn', l.description = 'MSI - gã khổng lồ trong làng laptop gaming, một lần nữa khẳng định vị thế tiên phong của mình với siêu phẩm laptop MSI Gaming Katana A15 AI B8VG R7 8845HS (465VN). Chiếc laptop này không chỉ là một cỗ máy chiến game mạnh mẽ mà còn là một kiệt tác nghệ thuật với thiết kế đỉnh cao. • Laptop MSI được trang bị bộ vi xử lý AMD Ryzen 7 8845HS với 8 nhân và 16 luồng, mang đến hiệu năng vượt trội cho mọi tác vụ. Tốc độ tối đa Turbo Boost lên đến 5.1 GHz, cho phép máy tăng cường hiệu suất đáng kể khi làm việc. Đặc biệt trong các tác vụ nặng như chơi game hay làm đồ họa đòi hỏi sự nhanh chóng và mạnh mẽ. • Được trang bị card rời NVIDIA GeForce RTX 4070 8 GB, MSI Katana mang đến cho bạn trải nghiệm chơi game và làm việc mượt mà, sắc nét. Chiến game AAA mở cài đặt cao, sáng tạo nội dung 3D chuyên nghiệp hay render video chất lượng cao, tất cả các tác vụ này đều được thực hiện dễ dàng hơn bao giờ hết. • Laptop gaming được trang bị RAM 16 GB DDR5 cho khả năng xử lý đa nhiệm mượt mà, bạn có thể mở nhiều ứng dụng cùng lúc mà không lo giật lag. Đồng thời laptop còn hỗ trợ mở rộng RAM lên đến 64 GB đáp ứng nhu cầu sử dụng chuyên nghiệp và tương lai. • MSI Katana được trang bị ổ cứng SSD M.2 PCIe NVMe tốc độ cao, mang đến trải nghiệm khởi động máy, khởi động ứng dụng và truy cập dữ liệu nhanh như chớp nhoáng. Dung lượng lưu trữ khổng lồ 1 TB đủ để lưu trữ mọi dữ liệu cá nhân cần thiết, từ tài liệu công việc, hình ảnh, video đến các tựa game yêu thích mà không lo thiếu dung lượng. • Màn hình Ful', l.launchYear = 2024, l.currentPrice = 32689999.999999996, l.currentPriceText = '32.690.000₫ *', l.originalPriceText = '39.990.000₫', l.discountPercentageText = '-18%'
