MERGE (l:Laptop {productId: '/laptop/lenovo-loq-15iax9-i5-83gs00dbvn'}) SET l.name = 'lenovo-loq-15iax9-i5-83gs00dbvn', l.url = 'https://www.thegioididong.com/laptop/lenovo-loq-15iax9-i5-83gs00dbvn', l.description = 'Từng chi tiết của laptop Lenovo LOQ 15IAX9 i5 12450HX (83GS00DBVN) đều được thiết kế để chinh phục thế giới game thật hấp dẫn với sức mạnh vượt trội cùng đa tính năng hữu ích. Hãy tham khảo ngay mẫu laptop gaming với thiết kế độc đáo, lạ mắt này với mức giá lý tưởng ở kệ hàng Thế Giới Di Động. • Cấu tạo máy thật phong cách với lớp vỏ nhựa màu xám, kiểu dáng đặc trưng với phần gù nhô ra trên những mẫu laptop gaming nhà Lenovo mang cảm hứng như những chiếc phi thuyền vũ trụ. Khối lượng 2.38 kg giúp bạn dễ dàng mang theo máy đến bất cứ đâu để luôn sẵn sàng cho những cuộc chiến mọi lúc mọi nơi. • Đèn nền đơn sắc trắng trên bàn phím sẽ là trợ thủ đắc lực trong những màn đêm game đầy thử thách, đảm bảo rằng game thủ luôn có thể chiến đấu hiệu quả ngay cả trong điều kiện ánh sáng yếu. Sự bố trí hợp lý của cổng kết nối như: LAN (RJ45), USB 3.2, HDMI, USB-C 3.2,... khiến việc kết nối với các thiết bị ngoại vi chưa bao giờ dễ dàng đến thế. • Màn hình 15.6 inch với độ phân giải Full HD (1920 x 1080) và tấm nền IPS không chỉ cho phép bạn trải nghiệm hình ảnh sắc nét mà còn cung cấp góc nhìn rộng lên đến 178 độ. Tần số quét 144 Hz kết hợp với công nghệ G-Sync đảm bảo rằng mọi chuyển động trong game đều mượt mà, giúp bạn phản xạ nhanh nhạy trong những tựa game đua xe, bắn súng hay hấp dẫn theo dõi những tựa phim bom tấn. • Chuẩn màu 100% sRGB là một công cụ hữu ích cho những ai làm việc với thiết kế đồ họa, giúp bạn đạt được màu sắc chính xác nhất cho mọi dự án. Hơn nữa, lớp phủ chống chói', l.launchYear = 2024, l.currentPrice = 20190000.0, l.currentPriceText = '20.190.000₫ *', l.originalPriceText = '23.490.000₫', l.discountPercentageText = '-14%'
