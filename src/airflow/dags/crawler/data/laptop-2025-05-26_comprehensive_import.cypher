MERGE (l:Laptop {productId: '/laptop/dell-xps-13-9350-ultra-7-xpsu7016w1'}) SET l.name = 'dell-xps-13-9350-ultra-7-xpsu7016w1', l.url = 'https://www.thegioididong.com/laptop/dell-xps-13-9350-ultra-7-xpsu7016w1', l.description = 'Dell XPS từ lâu đã khẳng định vị thế là dòng laptop cao cấp dành cho học sinh, sinh viên và nhân viên văn phòng, và phiên bản Dell XPS 13 9350 Ultra 7 256V (XPSU7016W1) không phải là ngoại lệ. Chiếc laptop này nổi bật với hiệu năng mạnh mẽ nhờ chip Intel Core Ultra 7 thế hệ mới, thiết kế mỏng nhẹ sang trọng, màn hình QHD+ sắc nét và thời lượng pin ấn tượng, hứa hẹn sẽ là người bạn đồng hành lý tưởng cho công việc và học tập. Với sự kết hợp hoàn hảo giữa hiệu năng và tính di động, đây chắc chắn là một lựa chọn đáng cân nhắc trong phân khúc laptop cao cấp. \"Quái vật hiệu năng\" ẩn mình trong dáng vẻ thanh lịch Mãn nhãn với không gian hiển thị sắc nét, sống động Âm thanh sống động, webcam sắc nét Thiết kế mỏng nhẹ, sang trọng và bền bỉ Kết nối đa dạng, thời lượng pin ấn tượng Dell XPS được trang bị bộ vi xử lý Intel Core Ultra 7 Lunar Lake - 256V với 8 nhân và 8 luồng, xung nhịp tối đa lên đến 4.8 GHz nhờ Turbo Boost. Điểm đặc biệt của chip Ultra 7 là NPU (Neural Processing Unit) Intel AI Boost, mang đến khả năng xử lý các tác vụ AI (trí tuệ nhân tạo) mạnh mẽ với hiệu năng lên đến 47 TOPS, giúp laptop AI này xử lý các tác vụ như nhận diện khuôn mặt, xử lý ảnh, dịch thuật và nhiều tác vụ khác một cách nhanh chóng và hiệu quả. Đi kèm với đó là card đồ họa tích hợp Intel Arc Graphics cho khả năng xử lý đồ họa mượt mà, đủ sức đáp ứng các nhu cầu làm việc văn phòng, học tập, giải trí và chơi game nhẹ nhàng. RAM 16 GB LPDDR5X bus 8533 MHz đảm bảo khả năng đa nhiệm tuyệt vời, cho phép', l.launchYear = 2023, l.currentPrice = 56990000.0, l.currentPriceText = '56.990.000₫ *', l.originalPriceText = '61.990.000₫', l.discountPercentageText = '-8%'
MATCH (l:Laptop {productId: '/laptop/dell-xps-13-9350-ultra-7-xpsu7016w1'}) SET l.cpuModel = 'Intel Core Ultra 7 Lunar Lake - 256V', l.cpuCores = 8, l.cpuThreads = 8, l.cpuBaseSpeedGHz = 2.2, l.cpuMaxSpeedText = 'Turbo Boost 4.8 GHz'
