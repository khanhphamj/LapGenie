MERGE (l:Laptop {productId: '/laptop/lenovo-ideapad-slim-3-15irh10-i7-83k1000fvn'}) SET l.name = 'lenovo-ideapad-slim-3-15irh10-i7-83k1000fvn', l.url = 'https://www.thegioididong.com/laptop/lenovo-ideapad-slim-3-15irh10-i7-83k1000fvn', l.description = 'Chiếc laptop Lenovo IdeaPad Slim 3 15IRH10 i7 13620H (83K1000FVN) lý tưởng cho học sinh, sinh viên và nhân viên văn phòng đang tìm kiếm một thiết bị mạnh mẽ, thiết kế mỏng nhẹ và màn hình sắc nét. Với bộ vi xử lý Intel Core i7 thế hệ 13, chiếc laptop này hứa hẹn mang đến hiệu năng vượt trội, đáp ứng mọi nhu cầu từ học tập, làm việc đến giải trí. Đây chắc chắn là một lựa chọn đáng cân nhắc trong phân khúc laptop tầm trung. Sức mạnh vượt trội, cân mọi tác vụ với Intel Core i7 Đắm chìm trong thế giới hình ảnh sắc nét Âm thanh sống động, webcam sắc nét cho trải nghiệm trọn vẹn Thiết kế mỏng nhẹ, độ bền chuẩn quân đội Kết nối đa dạng, pin trâu thỏa sức làm việc Trái tim của chiếc laptop này là bộ vi xử lý Intel Core i7 Raptor Lake - 13620H, với 10 nhân và 16 luồng, tốc độ xung nhịp cơ bản 2.4 GHz và có thể đạt tối đa 4.9 GHz nhờ Turbo Boost. Sức mạnh này cho phép máy xử lý mượt mà các tác vụ từ cơ bản đến nâng cao như soạn thảo văn bản, duyệt web, chỉnh sửa ảnh, video và chơi game. Card đồ họa tích hợp Intel UHD Graphics cũng đủ sức đáp ứng nhu cầu giải trí nhẹ nhàng và làm việc với các ứng dụng đồ họa không quá nặng. Với RAM 24 GB DDR5 tốc độ 4800 MHz, máy xử lý đa nhiệm mượt mà, tiết kiệm điện và phản hồi nhanh hơn thế hệ cũ. Kết hợp ổ cứng SSD 512 GB PCIe 4.0 cho tốc độ đọc ghi vượt trội, giúp khởi động máy, mở ứng dụng hay sao chép dữ liệu nhanh chóng. Người dùng còn có thể nâng cấp SSD lên tối đa 1 TB, linh hoạt đáp ứng nhu cầu lưu trữ lớn và hiệu suất cao. Lenovo IdeaPad Sli', l.launchYear = 2024, l.currentPrice = 20090000.0, l.currentPriceText = '20.090.000₫ *', l.originalPriceText = '20.490.000₫', l.discountPercentageText = ''
