MERGE (l:Laptop {productId: '/laptop/dell-inspiron-15-3520-i5-1235u-n3520i5u085w11blufp'}) SET l.name = 'dell-inspiron-15-3520-i5-1235u-n3520i5u085w11blufp', l.url = 'https://www.thegioididong.com/laptop/dell-inspiron-15-3520-i5-1235u-n3520i5u085w11blufp', l.description = 'Chiếc laptop Dell Inspiron 15 3520 i5 1235U (N3520-i5U085W11BLU-FP) - một lựa chọn sáng giá cho học sinh, sinh viên và nhân viên văn phòng đang tìm kiếm một chiếc laptop ổn định, mạnh mẽ và đa năng. Với thiết kế thanh lịch, hiệu năng ấn tượng và mức giá hợp lý, chiếc laptop này hứa hẹn sẽ là người bạn đồng hành đáng tin cậy trong công việc và học tập. Nếu bạn đang phân vân tìm kiếm một chiếc laptop đáp ứng tốt các nhu cầu trên thì đây chính là sản phẩm bạn không nên bỏ qua. \"Cân\" mọi tác vụ với sức mạnh từ Intel Core i5 thế hệ 12 Màn hình lớn sắc nét, trải nghiệm xem phim \"đã\" hơn bao giờ hết Âm thanh sống động, webcam sắc nét Thiết kế đơn giản, thanh lịch, bảo mật vân tay Kết nối đa dạng, pin \"trâu\" dùng cả ngày dài Dell Inspiron 15 3520 được trang bị bộ vi xử lý Intel Core i5 Alder Lake - 1235U với 10 nhân và 12 luồng, xung nhịp có thể đạt tối đa 4.4 GHz nhờ Turbo Boost. Với con chip này, laptop hoàn toàn có thể xử lý mượt mà các tác vụ văn phòng hàng ngày như soạn thảo văn bản, duyệt web, xem phim, nghe nhạc, cũng như các ứng dụng học tập và làm việc trực tuyến. Card đồ họa tích hợp Intel UHD Graphics cũng đủ sức đáp ứng nhu cầu chỉnh sửa ảnh cơ bản và chơi các game nhẹ nhàng. Laptop Dell Inspiron có sẵn 8 GB RAM DDR4 với tốc độ Bus 2666 MHz, đủ để bạn làm việc đa nhiệm mượt mà, mở nhiều tab trình duyệt và ứng dụng cùng lúc mà không lo giật lag. Nếu bạn có nhu cầu cao hơn, máy cũng hỗ trợ nâng cấp RAM lên đến 16 GB. Ổ cứng 512 GB SSD NVMe PCIe cho tốc độ truy xuất dữ', l.launchYear = 2021, l.currentPrice = 14490000.0, l.currentPriceText = '14.490.000₫ *', l.originalPriceText = '15.990.000₫', l.discountPercentageText = '-9%'
MATCH (l:Laptop {productId: '/laptop/dell-inspiron-15-3520-i5-1235u-n3520i5u085w11blufp'}) SET l.cpuModel = 'Intel Core i5 Alder Lake - 1235U', l.cpuCores = 10, l.cpuThreads = 12, l.cpuBaseSpeedGHz = 1.3, l.cpuMaxSpeedText = 'Turbo Boost 4.4 GHz'
