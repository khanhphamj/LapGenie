MERGE (l:Laptop {productId: '/laptop/lenovo-ideapad-slim-5-oled-14irh10-i5-83hr0001vn'}) SET l.name = 'lenovo-ideapad-slim-5-oled-14irh10-i5-83hr0001vn', l.url = 'https://www.thegioididong.com/laptop/lenovo-ideapad-slim-5-oled-14irh10-i5-83hr0001vn', l.description = 'Laptop Lenovo IdeaPad Slim 5 OLED 14IRH10 i5 13420H (83HR0001VN) là chiếc laptop lý tưởng cho dân thiết kế đồ họa, dựng video và kỹ thuật viên nhờ hiệu năng mạnh mẽ và màn hình OLED tuyệt đẹp. Với thiết kế mỏng nhẹ, chiếc laptop này hứa hẹn mang đến trải nghiệm làm việc và giải trí tuyệt vời, giúp bạn thỏa sức sáng tạo mọi lúc mọi nơi. Sức mạnh vượt trội cho mọi tác vụ Đắm chìm trong thế giới hình ảnh sống động Âm thanh sống động, bảo mật tối ưu Thiết kế mỏng nhẹ, độ bền ấn tượng Kết nối đa dạng, pin trâu Laptop được trang bị bộ vi xử lý Intel Core i5 Raptor Lake - 13420H với 8 nhân và 12 luồng, tốc độ xung nhịp lên đến 4.6 GHz nhờ Turbo Boost, cho khả năng xử lý mượt mà mọi tác vụ từ cơ bản đến nâng cao. Bạn có thể dễ dàng chỉnh sửa ảnh, dựng video, thiết kế đồ họa hay thậm chí chơi các tựa game như Liên Minh Huyền Thoại, CS:GO ở mức setting phù hợp. Card đồ họa tích hợp Intel UHD Graphics giúp máy xử lý tốt các tác vụ đồ họa nhẹ nhàng và xem video chất lượng cao. Đi kèm là RAM 32 GB DDR5 tốc độ 5600 MHz, đảm bảo khả năng đa nhiệm tuyệt vời, giúp bạn thoải mái mở nhiều ứng dụng cùng lúc mà không lo giật lag. Ổ cứng 1 TB SSD NVMe PCIe Gen 4 cho tốc độ đọc/ghi cực nhanh, giúp khởi động máy và mở ứng dụng chỉ trong tích tắc. Màn hình OLED 14 inch độ phân giải WUXGA (1920 x 1200) của laptop Lenovo IdeaPad mang đến trải nghiệm hiển thị tuyệt đỉnh với màu sắc sống động, độ tương phản sâu và góc nhìn rộng. Độ phủ màu 100% DCI-P3 đảm bảo màu sắc chính xác, lý tưởng cho các công việc', l.launchYear = 2023, l.currentPrice = 22690000.0, l.currentPriceText = '22.690.000₫', l.originalPriceText = '23.490.000₫', l.discountPercentageText = ''
