MERGE (l:Laptop {productId: '/laptop/hp-pavilion-16-af0055tu-ultra-5-ay8c4pa'}) SET l.name = 'hp-pavilion-16-af0055tu-ultra-5-ay8c4pa', l.url = 'https://www.thegioididong.com/laptop/hp-pavilion-16-af0055tu-ultra-5-ay8c4pa', l.description = 'Laptop HP Pavilion 16 af0055TU Ultra 5 125U (AY8C4PA) là sự lựa chọn tuyệt vời cho học sinh, sinh viên và nhân viên văn phòng đang tìm kiếm một chiếc máy tính xách tay mạnh mẽ, đa năng và đáng tin cậy. Chiếc laptop này nổi bật với hiệu năng ổn định, màn hình lớn sắc nét và thiết kế mỏng nhẹ, đáp ứng tốt mọi nhu cầu từ học tập, làm việc đến giải trí. Đây chắc chắn là một người bạn đồng hành lý tưởng, mang đến trải nghiệm tuyệt vời trong mọi hoạt động hàng ngày. \"Cân\" mọi tác vụ với sức mạnh chip AI Đắm chìm trong thế giới hình ảnh sắc nét với màn hình 16 inch Âm thanh sống động, Webcam chất lượng cao Thiết kế sang trọng, bền bỉ Kết nối đa dạng, pin khỏe HP Pavilion 16 af0055TU sở hữu bộ vi xử lý Intel Core Ultra 5 125U thuộc dòng Meteor Lake, với 12 nhân và 14 luồng, xung nhịp có thể tăng tốc lên đến 4.3 GHz nhờ Turbo Boost. Con chip này không chỉ mang lại hiệu năng mạnh mẽ để xử lý các tác vụ văn phòng, học tập mà còn đáp ứng tốt các nhu cầu giải trí đa phương tiện. Đặc biệt, sự tích hợp của NPU Intel AI Boost giúp tăng cường khả năng xử lý các tác vụ liên quan đến trí tuệ nhân tạo, mang đến trải nghiệm mượt mà và hiệu quả hơn. Đi kèm với CPU mạnh mẽ là card đồ họa tích hợp Intel Graphics, đủ sức để bạn chỉnh sửa ảnh cơ bản, xem video chất lượng cao và chơi các tựa game nhẹ nhàng. Laptop học tập - văn phòng này còn được trang bị 16 GB RAM LPDDR5 tốc độ 7467 MHz, đảm bảo khả năng đa nhiệm mượt mà, cho phép bạn mở nhiều ứng dụng cùng lúc mà không lo giật lag. Ổ cứng 512 GB SS', l.launchYear = 2024, l.currentPrice = 22390000.0, l.currentPriceText = '22.390.000₫ *', l.originalPriceText = '23.290.000₫', l.discountPercentageText = ''
