MERGE (l:Laptop {productId: '/laptop/dell-inspiron-15-3530-i5-n5i5530w1'}) SET l.name = 'dell-inspiron-15-3530-i5-n5i5530w1', l.url = 'https://www.thegioididong.com/laptop/dell-inspiron-15-3530-i5-n5i5530w1', l.description = 'Laptop Dell Inspiron 15 3530 i5 1334U (N5I5530W1) là sự lựa chọn hoàn hảo cho học sinh, sinh viên và nhân viên văn phòng, là sản phẩm đáng tin cậy. Với hiệu năng ổn định, thiết kế thanh lịch và các tính năng tiện dụng, chiếc laptop này hứa hẹn sẽ là người bạn đồng hành lý tưởng trong công việc và học tập. Đây là một lựa chọn tuyệt vời trong phân khúc giá tầm trung. \"Cân\" mọi tác vụ văn phòng, học tập với sức mạnh bên trong Đắm chìm trong không gian hiển thị sắc nét, sống động Âm thanh chân thực, webcam sắc nét cho trải nghiệm tuyệt vời Thiết kế thanh lịch, di động và bền bỉ Kết nối đa dạng, pin trâu dùng cả ngày dài Laptop Dell Inspiron 15 3530 i5 1334U (N5I5530W1) được trang bị bộ vi xử lý Intel Core i5 Raptor Lake - 1334U với 10 nhân và 12 luồng, xung nhịp cơ bản 1.3 GHz và có thể đạt tối đa 4.6 GHz nhờ Turbo Boost, giúp máy xử lý mượt mà các tác vụ văn phòng, học tập và giải trí hàng ngày. Card đồ họa tích hợp Intel Iris Xe Graphics đủ sức đáp ứng các nhu cầu đồ họa cơ bản, xem phim, lướt web và chơi các game nhẹ nhàng. Bộ nhớ RAM 16 GB DDR4 với tốc độ Bus 2666 MHz cho phép bạn thoải mái mở nhiều ứng dụng cùng lúc mà không lo giật lag, đồng thời hỗ trợ nâng cấp tối đa 16 GB để đáp ứng tốt hơn nhu cầu sử dụng trong tương lai. Ổ cứng 512 GB SSD NVMe PCIe không chỉ cung cấp không gian lưu trữ rộng rãi mà còn giúp máy khởi động nhanh chóng và truy xuất dữ liệu siêu tốc. Đặc biệt, máy còn hỗ trợ khe cắm HDD SATA 2.5 inch mở rộng, cho phép bạn nâng cấp thêm tối đa 1 TB dung lư', l.launchYear = 2024, l.currentPrice = 18490000.0, l.currentPriceText = '18.490.000₫ *', l.originalPriceText = '19.990.000₫', l.discountPercentageText = '-7%'
MATCH (l:Laptop {productId: '/laptop/dell-inspiron-15-3530-i5-n5i5530w1'}) SET l.cpuModel = 'Intel Core i5 Raptor Lake - 1334U', l.cpuCores = 10, l.cpuThreads = 12, l.cpuBaseSpeedGHz = 1.3, l.cpuMaxSpeedText = 'Turbo Boost 4.6 GHz'
