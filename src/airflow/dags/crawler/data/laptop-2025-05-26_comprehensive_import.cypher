MERGE (l:Laptop {productId: '/laptop/hp-omnibook-uf-14-fh0038tu-ultra-9-b2cp4pa'}) SET l.name = 'hp-omnibook-uf-14-fh0038tu-ultra-9-b2cp4pa', l.url = 'https://www.thegioididong.com/laptop/hp-omnibook-uf-14-fh0038tu-ultra-9-b2cp4pa', l.description = 'Laptop HP OmniBook UF 14 fh0038TU Ultra 9 288V (B2CP4PA) hướng đến đối tượng học sinh, sinh viên và nhân viên văn phòng, nổi bật với hiệu năng mạnh mẽ và thiết kế sang trọng. Đây là một lựa chọn đáng cân nhắc cho những ai tìm kiếm một chiếc laptop cao cấp, đa năng để phục vụ cho cả công việc và giải trí. Sức mạnh vượt trội, \"cân\" mọi tác vụ Mãn nhãn với màn hình OLED 2.8K sắc nét Âm thanh sống động, webcam sắc nét Thiết kế mỏng nhẹ, sang trọng Kết nối đa dạng, pin trâu Trái tim của chiếc laptop này là bộ vi xử lý Intel Core Ultra 9 288V thuộc dòng Arrow Lake mới nhất, với 8 nhân và 8 luồng, tốc độ xung nhịp có thể tăng tốc lên đến 5.1 GHz nhờ Turbo Boost. Đi kèm với đó là NPU Intel AI Boost, mang đến hiệu năng xử lý AI lên đến 47 TOPS, giúp bạn làm việc hiệu quả hơn với các ứng dụng đòi hỏi khả năng tính toán cao. RAM 32 GB chuẩn LPDDR5 với tốc độ Bus 8533 MHz đảm bảo khả năng đa nhiệm mượt mà, cho phép bạn mở nhiều ứng dụng cùng lúc mà không lo giật lag. Ổ cứng 1 TB SSD M.2 PCIe Gen 4 không chỉ cung cấp không gian lưu trữ rộng lớn mà còn giúp máy khởi động và truy xuất dữ liệu cực nhanh. Tuy không hỗ trợ nâng cấp RAM, nhưng bạn có thể tháo rời ổ cứng và thay thế bằng thanh khác tối đa 2 TB để mở rộng dung lượng lưu trữ. Laptop HP OmniBook sở hữu màn hình 14 inch độ phân giải 2.8K (2880 x 1800) với tấm nền OLED, tỷ lệ khung hình 16:10 mang đến không gian hiển thị rộng rãi hơn. Tần số quét 48 - 120 Hz cho trải nghiệm hình ảnh mượt mà, đặc biệt khi xem phim hoặc chơi game. Độ', l.launchYear = 2024, l.currentPrice = 57090000.0, l.currentPriceText = '57.090.000₫ *', l.originalPriceText = '57.990.000₫', l.discountPercentageText = ''
