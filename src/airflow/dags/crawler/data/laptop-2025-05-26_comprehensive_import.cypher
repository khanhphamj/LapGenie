MERGE (l:Laptop {productId: '/laptop/asus-fx507zc4-i7-hn181w'}) SET l.name = 'asus-fx507zc4-i7-hn181w', l.url = 'https://www.thegioididong.com/laptop/asus-fx507zc4-i7-hn181w', l.description = 'Khám phá không gian giải trí tuyệt vời trên mẫu laptop ASUS TUF Gaming F15 FX507ZC4 i7 12700H (HN181W) vốn đã cực kì quen thuộc với nhiều game thủ hiện nay. Laptop gaming sở hữu mức giá thành hợp lý nhưng lại có cấu hình vượt trội hơn mong đợi cho giải trí, chiến game hay làm việc thường ngày. • Khám phá thế giới giải trí và làm việc không giới hạn với chiếc laptop gaming trang bị CPU Intel Core i7 Alder Lake - 12700H đi cùng card rời NVIDIA GeForce RTX 3050 4 GB, đáp ứng khả năng xử lý mạnh mẽ và mượt mà, không chỉ cho các tựa game đỉnh cao như Cyberpunk 2077, Fortnite,... mà còn cho các tác vụ sáng tạo hình ảnh, nội dung và video trên nhiều nền tảng đặc thù. • Tận dụng tối đa khả năng từ chiếc máy của bạn với MUX Switch và NVIDIA Optimus, cho phép chuyển đổi linh hoạt để cải thiện hiệu năng khi chơi game, tăng tốc độ chỉnh sửa đồ hoạ, render video và tiết kiệm điện năng khi thao tác với các công việc thông dụng. • Bộ nhớ RAM 16 GB có tốc độ Bus 3200 MHz thực hiện trơn tru nhiều công việc cùng lúc, mở đồ hoạ, game mà không bị giảm hiệu suất. Thông số RAM trên laptop Asus TUF Gaming còn có thể nâng cấp lên tối đa 32 GB, đáp ứng nhu cầu sử dụng của những game thủ và người dùng chuyên nghiệp. • Ổ cứng SSD NVMe PCIe dung lượng 512 GB không chỉ giúp khởi động máy nhanh hơn mà còn cung cấp không gian lưu trữ rộng rãi có thể mở rộng đến 1 TB cho các tựa game nặng, tải xuống các phần mềm đồ hoạ và render các sản phẩm sáng tạo không lo hết tài nguyên. • Màn hình IPS có kích thước 15', l.launchYear = 2023, l.currentPrice = 23190000.0, l.currentPriceText = '23.190.000₫ *', l.originalPriceText = '26.990.000₫', l.discountPercentageText = '-14%'
