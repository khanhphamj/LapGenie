MERGE (l:Laptop {productId: '/laptop/hp-elitebook-630-g10-i7-9h1n9pt?utm_flashsale=1'}) SET l.name = 'hp-elitebook-630-g10-i7-9h1n9pt?utm_flashsale=1', l.url = 'https://www.thegioididong.com/laptop/hp-elitebook-630-g10-i7-9h1n9pt?utm_flashsale=1', l.description = 'Nhỏ gọn, sang trọng cho cả ngày dài di chuyển hay tiện dụng và mạnh mẽ cho mọi công việc cá nhân đều được tích hợp trên laptop HP Elitebook 630 G10 i7 1355U (9H1N9PT). Tham khảo ngay mẫu máy tiện dụng này với mức giá thành hợp lý tại Thế Giới Di Động để hoàn thiện thật tốt mọi vấn đề. • Chiếc laptop học tập - văn phòng này có giao diện ngoài nhỏ gọn với khối lượng chỉ 1.28 kg, thân máy được vuốt mảnh mai, điểm nhấn bởi logo HP ánh bạc trên mặt A, thể hiện độ tinh tế mà dòng Elitebook muốn mang đến cho người dùng. Vỏ máy chế tác từ kim loại, tăng độ sang trọng và đảm bảo tính bền chắc trong quá trình sử dụng. Sự nhỏ gọn và nhẹ nhàng này giúp người dùng dễ dàng mang theo và sử dụng ở mọi nơi, từ văn phòng đến các cuộc họp hay khi di chuyển. • Tính năng bảo mật vân tay giúp bạn truy cập vào laptop thuận tiện và bảo mật hơn chỉ với một chạm đơn giản. Công tắc khoá camera này đảm bảo dữ liệu của bạn luôn an toàn trước những nguy cơ xâm nhập trái phép. • Bàn phím có đèn nền hỗ trợ làm việc vào buổi khuya hay ở những nơi thiếu sáng, tăng cường sự tiện dụng và thoải mái cho người dùng. Máy được trang bị đầy đủ các cổng kết nối thông dụng dọc 2 bên thiết bị như: LAN (RJ45), USB 3.2, HDMI, Thunderbolt 4,... giúp người dùng dễ dàng kết nối với các thiết bị ngoại vi. • Laptop HP sử dụng chip Intel Core i7 1355U có tốc độ xung nhịp tối đa lên đến 5.0 GHz đi kèm với card Intel UHD Graphics, đảm bảo khả năng vận hành hoàn hảo mọi tác vụ học tập, doanh nghiệp trên Word, Excel, PowerPoint,...', l.launchYear = 2023, l.currentPrice = 27490000.0, l.currentPriceText = '27.490.000₫', l.originalPriceText = '27.790.000₫', l.discountPercentageText = ''
