MERGE (l:Laptop {productId: '/laptop/msi-thin-15-b13uc-i7-1411vn'}) SET l.name = 'msi-thin-15-b13uc-i7-1411vn', l.url = 'https://www.thegioididong.com/laptop/msi-thin-15-b13uc-i7-1411vn', l.description = 'Laptop MSI Thin 15 B13UC i7 13620H (1411VN) không chỉ sở hữu hiệu năng mạnh mẽ, màn hình chất lượng cao và thiết kế mỏng nhẹ mà còn đáp ứng mọi nhu cầu từ công việc đến giải trí. Với Intel Core i7 thế hệ 13, card rời RTX 30 series, màn hình 144 Hz và các tính năng hiện đại khác, đây là lựa chọn lý tưởng cho game thủ, nhà sáng tạo nội dung và người dùng chuyên nghiệp. \"Cân\" mọi tác vụ với sức mạnh vượt trội từ Intel Core i7 thế hệ 13 Đắm chìm trong thế giới game với màn hình 144Hz sắc nét Âm thanh sống động, webcam sắc nét cho trải nghiệm hoàn hảo Thiết kế mỏng nhẹ, độ bền ấn tượng Kết nối đa dạng, thời lượng pin ổn định Laptop MSI Thin được trang bị bộ vi xử lý Intel Core i7 Raptor Lake 13620H, một trong những dòng CPU tiên tiến nhất hiện nay. Với 10 nhân 16 luồng, CPU này xử lý mượt mà mọi tác vụ, từ làm việc văn phòng đến chỉnh sửa video hay lập trình. Turbo Boost lên đến 4.9 GHz giúp máy đạt hiệu suất tối ưu trong các ứng dụng nặng, mang lại trải nghiệm mượt mà và nhanh chóng, tiết kiệm thời gian làm việc cho người dùng. Với card đồ họa rời NVIDIA GeForce RTX 3050 4 GB, MSI Thin 15 đáp ứng tốt nhu cầu xử lý đồ họa từ chỉnh sửa video, thiết kế 3D đến chơi các tựa game AAA. Công nghệ Ray Tracing và AI DLSS của NVIDIA giúp tăng cường hiệu suất, tái hiện hình ảnh sống động và chi tiết hơn. Người dùng có thể trải nghiệm chơi game mượt mà hoặc sáng tạo nội dung mà không lo giật, lag. Đây là chiếc laptop gaming được trang bị 32 GB RAM DDR4, mang lại khả năng xử lý đa nhiệm mạnh', l.launchYear = 2024, l.currentPrice = 21890000.0, l.currentPriceText = '21.890.000₫', l.originalPriceText = '21.990.000₫', l.discountPercentageText = ''
