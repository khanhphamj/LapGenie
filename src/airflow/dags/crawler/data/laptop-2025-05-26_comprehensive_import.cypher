MERGE (l:Laptop {productId: '/laptop/hp-probook-450-g10-i7-9h8h1pt?utm_flashsale=1'}) SET l.name = 'hp-probook-450-g10-i7-9h8h1pt?utm_flashsale=1', l.url = 'https://www.thegioididong.com/laptop/hp-probook-450-g10-i7-9h8h1pt?utm_flashsale=1', l.description = 'Laptop HP Probook 450 G10 i7 1355U (9H8H1PT) sở hữu thiết kế hiện đại, thanh lịch với lớp vỏ kim loại nguyên khối và tông màu bạc sáng. Hiệu năng xử lý đến từ con chip Intel Core i7 thế hệ 13 mạnh mẽ, RAM và ổ cứng ổn định mang đến trải nghiệm vượt trội trong học tập và giải trí. • Điểm nhấn thiết kế với lớp vỏ kim loại màu bạc sáng đặc trưng, khung viền thanh mảnh tạo độ thẩm mỹ hiện đại cho mọi không gian sử dụng. Hơn nữa, máy được hoàn thiện với chất liệu kim loại cũng gia tăng thêm độ bền bỉ cho tổng thể laptop HP. • Bàn phím laptop có hành trình phím sâu, phím bấm êm ái và độ phản hồi tốt, giúp bạn thao tác nhanh chóng và chính xác. Bàn phím cũng được trang bị đèn nền giúp bạn dễ dàng sử dụng máy trong điều kiện thiếu sáng. • Thiết bị cũng cho người dùng truy cập dễ dàng qua một chạm với bảo mật vân tay, vừa tiện lợi lại vừa an toàn cho thông tin cá nhân. HP ProBook 450 G10 sở hữu đầy đủ các cổng kết nối thông dụng như HDMI, USB 3.2, LAN, USB Type-C,... giúp người dùng dễ dàng kết nối với các thiết bị ngoại vi khác như máy chiếu, màn hình phụ, chuột, bàn phím,... • Laptop HP Probook được gắn với vi xử lý Intel Core i7 1355U thế hệ 13 vượt trội và card Intel UHD Graphics, mang đến hiệu năng mạnh mẽ, đáp ứng mọi nhu cầu học tập, văn phòng và giải trí của bạn. Con chip này sở hữu tối đa 10 nhân, 12 luồng và tốc độ xung nhịp tối đa lên đến 5.0 GHz, giúp người dùng xử lý mượt mà các tác vụ nặng như đồ họa thông dụng, lập trình, chỉnh sửa video,... mà không gặp bất kỳ trở ngại', l.launchYear = 2023, l.currentPrice = 24990000.0, l.currentPriceText = '24.990.000₫ *', l.originalPriceText = '26.990.000₫', l.discountPercentageText = '-7%'
