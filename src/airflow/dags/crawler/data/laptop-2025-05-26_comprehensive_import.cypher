MERGE (l:Laptop {productId: '/laptop/lenovo-v15-g5-irl-core-5-83hf0000vn'}) SET l.name = 'lenovo-v15-g5-irl-core-5-83hf0000vn', l.url = 'https://www.thegioididong.com/laptop/lenovo-v15-g5-irl-core-5-83hf0000vn', l.description = 'Laptop Lenovo V15 G5 IRL Core 5 120U (83HF0000VN) là sự kết hợp hoàn hảo giữa hiệu suất mạnh mẽ và thiết kế hiện đại, phù hợp cho học sinh, sinh viên và nhân viên văn phòng. Với cấu hình ổn định, dung lượng lưu trữ rộng rãi và vẻ ngoài cuốn hút, sản phẩm này đang được bán với mức giá hấp dẫn tại Thế Giới Di Động. • Trái tim của Lenovo V15 G5 chính là bộ vi xử lý Intel Core 5 Raptor Lake - 120U, gồm 10 nhân và 12 luồng hoạt động cùng công nghệ Turbo Boost, đẩy tốc độ lên tối đa tới 5.0 GHz. Điều này đảm bảo rằng mọi tác vụ, từ công việc văn phòng với Word, Excel, PowerPoint cho đến những ứng dụng đồ họa cơ bản, đều được xử lý mượt mà. Bạn còn có thể dễ dàng làm việc với các nền tảng coding, khiến sản phẩm này trở thành công cụ hữu ích cho cả lập trình viên. • Sở hữu card đồ họa tích hợp Intel Graphics, laptop không chỉ mang lại hình ảnh chất lượng cao cho các hoạt động xem phim, chỉnh sửa ảnh trên Photoshop, AI hay Canva mà còn đủ sức chạy các tựa game nhẹ nhàng để bạn thư giãn sau những giờ làm việc căng thẳng. • Với RAM 16 GB, chiếc laptop Lenovo V Series này cho phép bạn mở hàng chục ứng dụng cùng lúc mà vẫn đảm bảo hoạt động mượt mà, hạn chế tình trạng giật lag. Ổ cứng SSD 512 GB NVMe PCIe 4.0 không chỉ cung cấp dung lượng lưu trữ dồi dào mà còn mang lại tốc độ truy xuất dữ liệu nhanh chóng, giúp bạn làm việc hiệu quả hơn. • Màn hình IPS 15.6 inch với độ phân giải Full HD (1920 x 1080) cung cấp hình ảnh rõ nét, màu sắc chân thực, phù hợp với mọi nhu cầu sử dụng từ công việ', l.launchYear = 2024, l.currentPrice = 17890000.0, l.currentPriceText = '17.890.000₫', l.originalPriceText = '19.890.000₫', l.discountPercentageText = '-10%'
