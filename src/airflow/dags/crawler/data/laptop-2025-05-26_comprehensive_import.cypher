MERGE (l:Laptop {productId: '/laptop/asus-x1404va-i5-nk771ws'}) SET l.name = 'asus-x1404va-i5-nk771ws', l.url = 'https://www.thegioididong.com/laptop/asus-x1404va-i5-nk771ws', l.description = 'Laptop Asus Vivobook 14 X1404VA i5 1334U (NK771WS) là sự lựa chọn tuyệt vời cho học sinh, sinh viên và nhân viên văn phòng đang tìm kiếm một chiếc laptop đáng tin cậy. Với hiệu năng ổn định và thiết kế mỏng nhẹ, chiếc laptop này đáp ứng tốt nhu cầu học tập, làm việc và giải trí hàng ngày, mang lại giá trị vượt trội trong phân khúc giá. \"Cân\" mọi tác vụ văn phòng, học tập với sức mạnh từ Intel thế hệ 13 Đắm chìm trong thế giới hình ảnh sắc nét, sống động Âm thanh sống động, webcam sắc nét cho trải nghiệm tuyệt vời Thiết kế mỏng nhẹ, độ bền chuẩn quân đội Đầy đủ cổng kết nối, pin dùng cả ngày dài Trái tim của Asus Vivobook 14 X1404VA là bộ vi xử lý Intel Core i5 Raptor Lake - 1334U với 10 nhân và 12 luồng, xung nhịp có thể đạt tối đa 4.6 GHz nhờ Turbo Boost. Điều này cho phép laptop xử lý mượt mà các tác vụ văn phòng, duyệt web, xem phim và thậm chí là chỉnh sửa ảnh, video cơ bản. Card đồ họa tích hợp Intel Iris Xe Graphics cũng giúp tăng cường khả năng xử lý đồ họa, đáp ứng tốt nhu cầu giải trí và làm việc liên quan đến hình ảnh. Laptop Asus có sẵn 16 GB RAM DDR4 tốc độ 3200 MHz (8 GB onboard + 1 khe 8 GB), đảm bảo khả năng đa nhiệm mượt mà, cho phép bạn mở nhiều ứng dụng cùng lúc mà không lo giật lag. Ổ cứng 512 GB SSD NVMe PCIe không chỉ cung cấp không gian lưu trữ đủ dùng mà còn giúp máy khởi động nhanh chóng và truy xuất dữ liệu cực kỳ nhanh chóng. Bạn hoàn toàn có thể nâng cấp ổ cứng lên tối đa 1 TB nếu có nhu cầu lưu trữ lớn hơn. Vivobook 14 X1404VA sở hữu màn hình 14 ', l.launchYear = 2025, l.currentPrice = 15290000.0, l.currentPriceText = '15.290.000₫ *', l.originalPriceText = '16.490.000₫', l.discountPercentageText = '-7%'
