MERGE (l:Laptop {productId: '/laptop/dell-inspiron-7440-core-5-n4i5006w1'}) SET l.name = 'dell-inspiron-7440-core-5-n4i5006w1', l.url = 'https://www.thegioididong.com/laptop/dell-inspiron-7440-core-5-n4i5006w1', l.description = 'Laptop Dell Inspiron 7440 Core 5 120U (N4I5006W1) không chỉ là chiếc laptop cao cấp, mà còn là một công cụ mạnh mẽ được thiết kế riêng cho các chuyên gia đồ họa, lập trình viên và người dùng sáng tạo. Mang dáng vẻ tinh tế và khả năng vận hành vượt trội, chiếc laptop này định nghĩa lại tiêu chuẩn của dòng máy doanh nhân, mở ra trải nghiệm làm việc và giải trí đỉnh cao. Hiệu năng ổn định cho công việc và học tập Màn hình cảm ứng Full HD+ sắc nét Âm thanh sống động và webcam sắc nét Thiết kế linh hoạt, độ bền cao Cổng kết nối đa dạng và thời lượng pin ấn tượng Laptop được trang bị bộ vi xử lý Intel Core 5 Raptor Lake - 120U với 10 nhân và 12 luồng, cho tốc độ xung nhịp lên đến 5.0 GHz nhờ Turbo Boost. Cấu hình này không chỉ đáp ứng tốt các tác vụ văn phòng cơ bản mà còn xử lý mượt mà các ứng dụng chỉnh sửa ảnh, video nhẹ nhàng. Card đồ họa tích hợp Intel Graphics giúp bạn xem phim, lướt web và chơi các game online nhẹ nhàng một cách trơn tru. Dung lượng RAM 16 GB chuẩn DDR5 5200 MHz đảm bảo khả năng đa nhiệm tuyệt vời, cho phép bạn mở nhiều ứng dụng cùng lúc mà không lo giật lag. Ổ cứng 1 TB SSD M.2 PCIe giúp máy khởi động nhanh chóng và tăng tốc độ truy xuất dữ liệu, mang lại trải nghiệm sử dụng mượt mà và hiệu quả. Dell Inspiron 7440 sở hữu màn hình 14 inch độ phân giải Full HD+ (1920 x 1200) mang đến hình ảnh sắc nét và sống động. Công nghệ WVA (Wide Viewing Angle) cho góc nhìn rộng, giúp bạn thoải mái xem phim và làm việc ở nhiều góc độ khác nhau. Độ phủ màu 45% NTSC đáp ứng', l.launchYear = 2023, l.currentPrice = 28490000.0, l.currentPriceText = '28.490.000₫ *', l.originalPriceText = '30.990.000₫', l.discountPercentageText = '-8%'
