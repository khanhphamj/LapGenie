MERGE (l:Laptop {productId: '/laptop/hp-omen-16-xf0070ax-r9-8w945pa'}) SET l.name = 'hp-omen-16-xf0070ax-r9-8w945pa', l.url = 'https://www.thegioididong.com/laptop/hp-omen-16-xf0070ax-r9-8w945pa', l.description = 'Đón chào sự trở lại của siêu phẩm laptop gaming OMEN đến từ nhà HP sau khoảng thời gian dài vắng bóng trên đường đua công nghệ, laptop HP OMEN 16 xf0070AX R9 7940HS (8W945PA) với bộ cấu hình vượt trội, màn hình 2K sắc nét có tốc độ quét cao,... đảm bảo cung cấp đầy đủ những yếu tố cần thiết nhất cho hành trình chiến game chuyên nghiệp của bạn. Chiến hấp dẫn mọi thể loại game Mức phân giải 2K chân thực, hút mắt hơn Cắt nét sắc sảo, mức sang trọng đi cùng độ cá tính Laptop HP OMEN sử dụng vi xử lý AMD Ryzen 9 7940HS sở hữu 8 nhân 16 luồng có tốc độ xung nhịp cao nhất lên đến 5.20 GHz cho bạn cảm nhận độ mượt tuyệt vời trong khi trải nghiệm những con game AAA đồ hoạ cấu hình cao, đủ sức đương đầu với những công việc thiết kế phức tạp, quay dựng phim,... VGA NVIDIA GeForce RTX 4070 8 GB thuộc thế hệ mới với những tính năng dựng hình hàng đầu như DLSS 3 buff hiệu suất card cực cao qua tính năng AI, mang lại tốc độ khung hình cực ổn định, thiết kế model 3D hay quay dựng phim \"ngon lành\". Ngoài ra, Ray Tracing còn làm sống động các vật thể, nhân vật trong game hay đồ hoạ nhờ khả năng tái tạo đổ bóng theo thế giới thực. Laptop HP được trang bị bộ nhớ RAM mặc định là 32 GB, mang lại độ phản hồi cao trong mọi tình huống sử dụng, chiến game, làm đồ hoạ hay đến lập trình phần mềm đòi hỏi nhiều tài nguyên đều không thành vấn đề. Game thủ cũng có thể linh động nâng RAM lên tận 64 GB tuỳ theo nhu cầu. Ổ cứng SSD 1 TB M.2 PCIe Gen 4 cho tốc độ truy xuất dữ liệu tuyệt vời, rút ngắn hơn thời', l.launchYear = 2024, l.currentPrice = 62890000.0, l.currentPriceText = '62.890.000₫', l.originalPriceText = '', l.discountPercentageText = ''
