MERGE (l:Laptop {productId: '/laptop/lenovo-thinkbook-16-g6-i5-21kh00q0vn'}) SET l.name = 'lenovo-thinkbook-16-g6-i5-21kh00q0vn', l.url = 'https://www.thegioididong.com/laptop/lenovo-thinkbook-16-g6-i5-21kh00q0vn', l.description = 'Laptop Lenovo ThinkBook 16 G6 i5 13420H (21KH00Q0VN) là người bạn đồng hành lý tưởng cho học sinh, sinh viên và nhân viên văn phòng, đáp ứng mọi nhu cầu từ học tập, làm việc đến giải trí. Với hiệu năng ổn định, màn hình sắc nét và thiết kế bền bỉ, chiếc Laptop Lenovo ThinkBook 16 G6 i5 13420H (21KH00Q0VN) hứa hẹn mang đến trải nghiệm làm việc và học tập hiệu quả, nâng tầm năng suất của bạn. Sức mạnh vượt trội cho mọi tác vụ Màn hình sắc nét, trải nghiệm mãn nhãn Âm thanh sống động và các tính năng hỗ trợ khác Thiết kế bền bỉ, đậm chất doanh nhân Cổng kết nối đa dạng, thời lượng pin ấn tượng Trái tim của chiếc laptop này là bộ vi xử lý Intel Core i5 Raptor Lake - 13420H, với 8 nhân và 12 luồng, xung nhịp có thể đạt tối đa 4.6 GHz nhờ Turbo Boost, giúp bạn xử lý mượt mà mọi tác vụ từ cơ bản đến phức tạp. Card đồ họa tích hợp Intel UHD Graphics đủ sức đáp ứng các nhu cầu làm việc văn phòng, học tập và giải trí nhẹ nhàng. Bộ nhớ RAM 16 GB DDR5 2 khe (1 khe 8 GB + 1 khe 8 GB) với tốc độ Bus RAM 5200 MHz giúp máy đa nhiệm mượt mà, bạn có thể mở nhiều ứng dụng cùng lúc mà không lo giật lag. Ổ cứng 512 GB SSD NVMe PCIe 4.0 cho tốc độ đọc/ghi nhanh chóng, giúp khởi động máy và mở ứng dụng chỉ trong tích tắc. Máy còn hỗ trợ nâng cấp RAM lên đến 64 GB và ổ cứng tối đa 2 TB, đáp ứng nhu cầu lưu trữ và sử dụng lâu dài. Lenovo ThinkBook 16 G6 sở hữu màn hình 16 inch độ phân giải WUXGA (1920 x 1200) mang đến hình ảnh sắc nét, rõ ràng. Tấm nền IPS cho góc nhìn rộng, màu sắc trung thực. Công ', l.launchYear = 2024, l.currentPrice = 19090000.0, l.currentPriceText = '19.090.000₫', l.originalPriceText = '20.590.000₫', l.discountPercentageText = '-7%'
