MERGE (l:Laptop {productId: '/laptop/acer-nitro-5-tiger-an515-58-52sp-i5-nhqfhsv001'}) SET l.name = 'acer-nitro-5-tiger-an515-58-52sp-i5-nhqfhsv001', l.url = 'https://www.thegioididong.com/laptop/acer-nitro-5-tiger-an515-58-52sp-i5-nhqfhsv001', l.description = 'Một bước tiến cấu hình vượt bậc được Acer ưu ái trên chiếc laptop Acer Nitro 5 Tiger AN515 58 52SP i5 (NH.QFHSV.001) khi trang bị bộ vi xử lý Intel Gen 12 đầy mạnh mẽ cùng phong cách thiết kế đậm chất “mãnh hổ”, khơi nguồn sức mạnh tiềm ẩn bên trong mỗi game thủ trên mọi chiến trường ảo. Bùng nổ sức mạnh với con chip Intel Gen 12 mạnh mẽ Lịch lãm, sang trọng trên từng đường nét máy Mình đã rất kinh ngạc khi Nitro 5 Tiger không chỉ đặc biệt với cái tên trùng với con giáp Mãnh Hổ của năm 2022 mà còn là một trong những nhân vật đại diện đầu tiên của nhà Acer tân trang con chip Intel thế hệ 12 đầy mạnh mẽ. Để giải đáp sự tò mò về sức mạnh vượt bậc của bộ vi xử lý Intel Core i5 Alder Lake 12500H này, mình sẽ sử dụng phần mềm Cinebench R20 để kiểm chứng khả năng của em nó đến đâu nhé. Sau những phút chờ đợi “vất vả” thì mình đo được 4723 điểm với đa nhân và 642 điểm với đơn nhân, cho khả năng xử lý mọi tác vụ trên cả tuyệt vời, bên cạnh đó cũng “ăn” cao nhất 87 W điện cho CPU và tiêu tốn 93 độ khi chưa bật Nitro Sense. Sẵn đang đề cập đến Nitro Sense thì mình cho ngay chiếc laptop này 10 điểm cộng với tốc độ quạt được cải tiến hơn 7000 vòng trên phút, trong khi những thế hệ cũ chỉ nằm đâu đó khoảng 5000 - 6000 vòng, từ đó giúp cải thiện rất nhiều cho khả năng tản nhiệt của máy mỗi khi chiến các tựa game đình đám. Để làm nên một bộ đôi hoàn mỹ cho Nitro 5 Tiger thì đi bên cạnh CPU Gen 12 không thể thiếu “bóng dáng” của chiếc card rời NVIDIA GeForce RTX 3050 4 GB, mang đến hiệu suất ', l.launchYear = 2022, l.currentPrice = 19690000.0, l.currentPriceText = '19.690.000₫ *', l.originalPriceText = '27.990.000₫', l.discountPercentageText = '-29%'
