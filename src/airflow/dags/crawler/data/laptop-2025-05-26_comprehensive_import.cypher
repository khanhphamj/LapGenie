MERGE (l:Laptop {productId: '/laptop/hp-elitebook-635-aero-g11-r5-a8ws6pt'}) SET l.name = 'hp-elitebook-635-aero-g11-r5-a8ws6pt', l.url = 'https://www.thegioididong.com/laptop/hp-elitebook-635-aero-g11-r5-a8ws6pt', l.description = 'Nếu bạn đang tìm kiếm một chiếc laptop không chỉ đáp ứng nhu cầu công việc mà còn mang lại cảm hứng sáng tạo và phong cách sống hiện đại, thì chắc chắn không thể bỏ qua laptop HP Elitebook 635 Aero G11 R5 8640U (A8WS6PT). Với sự kết hợp hoàn hảo giữa thiết kế sang trọng, hiệu năng linh hoạt mạnh mẽ và loạt tính năng đột phá, định dạng lại phong cách sống và làm việc cho người dùng. • Với bộ vi xử lý AMD Ryzen 5 8640U, laptop HP sở hữu sức mạnh xử lý tuyệt vời cho các tác vụ từ cơ bản đến phức tạp. Tần số tối đa lên đến 4.9 GHz kết hợp cùng card đồ họa AMD Radeon Graphics cho phép bạn dễ dàng tiếp cận hơn với các nền tảng dữ liệu lớn, đồ hoạ, lập trình phức tạp. Không chỉ thế, các thao tác tính toán thông dụng ở bộ Office hay Google Workspace cũng trở nên linh hoạt mà hiệu quả hơn rất nhiều. • Thế hệ chip mới từ AMD còn bổ sung thêm AMD XDNA, một nhân xử lý AI độc quyền từ thương hiệu với 16 TOPS thực hiện nhanh chóng hơn trong công việc tính toán, học hỏi được thói quen người dùng để cắt giảm và boost hiệu năng đúng lúc cho quá trình tiết kiệm pin tốt hơn. Ngoài ra, trí tuệ nhân tạo cũng cho phép tích hợp ở một số các phần mềm đồ hoạ, lập trình và trợ lý ảo Copilot thực hiện giải đáp thắc mắc. • RAM 16 GB hỗ trợ đa nhiệm mượt mà, trong khi ổ cứng SSD 512 GB NVMe PCIe đảm bảo tốc độ truy xuất dữ liệu nhanh chóng. Điểm đặc biệt của chiếc laptop này là khả năng nâng cấp ổ cứng lên đến 1 TB, rất phù hợp cho những người dùng cần không gian lưu trữ lớn để quản lý các dự án phức tạp', l.launchYear = 2024, l.currentPrice = 24490000.0, l.currentPriceText = '24.490.000₫ *', l.originalPriceText = '25.390.000₫', l.discountPercentageText = ''
