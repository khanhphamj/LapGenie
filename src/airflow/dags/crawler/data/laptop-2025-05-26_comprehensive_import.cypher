MERGE (l:Laptop {productId: '/laptop/acer-aspire-lite-16-g2-al16-52p-76du-i7-nxj2ssv005'}) SET l.name = 'acer-aspire-lite-16-g2-al16-52p-76du-i7-nxj2ssv005', l.url = 'https://www.thegioididong.com/laptop/acer-aspire-lite-16-g2-al16-52p-76du-i7-nxj2ssv005', l.description = 'Laptop Acer Aspire Lite 16 G2 AL16 52P 76DU i7 1355U (NX.J2SSV.005) sở hữu lối tinh giản trên từng chi tiết, hỗ trợ chuyên nghiệp hơn với cấu hình mạnh mẽ nhờ con chip Intel Core i7, mẫu laptop học tập - văn phòng từ thương hiệu Acer là sự lựa chọn vô cùng phù hợp với các sinh viên, người đi làm cần một công cụ tốt để làm việc và giải trí. Thiết kế tối giản, độ bền ấn tượng Kết nối đa dạng, pin \"trâu\" \"Cân\" mọi tác vụ đồ họa, dựng video với sức mạnh vượt trội Mãn nhãn với không gian hiển thị rộng lớn, sắc nét Âm thanh sống động, webcam sắc nét Thiết kế sang trọng với lớp vỏ nhựa chắc chắn và gam màu bạc hiện đại, cùng các viền máy bo tròn mềm mại tạo cảm giác thoải mái khi cầm nắm. Mặt A của máy cũng điểm thêm vài đường nét hoa văn độc đáo tăng thêm tính hiện đại và thẩm mỹ đáng kể. khối lượng 1.7 kg nên laptop này dễ dàng đồng hành cùng bạn mọi lúc, mọi nơi. Thiết bị này còn có đầy đủ các dạng cổng kết nối phổ thông như Jack tai nghe 3.5 mm, USB 3.2, HDMI, USB Type-C và Micro SD đảm bảo việc truyền tải dữ liệu nhanh chóng và hiệu quả. Kết nối không dây Wi-Fi 6 (802.11ax) và Bluetooth 5 cho tốc độ truyền dữ liệu nhanh chóng, ổn định. Pin 3-cell Li-ion, 58 Wh cho thời lượng sử dụng khá, giúp bạn làm việc thoải mái trong nhiều giờ liền. Về phần cứng, laptop Acer Aspire được trang bị bộ vi xử lý Intel Core i7 1355U thế hệ 13 mạnh mẽ, kết hợp với card đồ họa Intel Iris Xe Graphics eligible cho khả năng tương thích tuyệt vời với mọi công việc chỉnh sửa hình ảnh và video đơn gi', l.launchYear = 2024, l.currentPrice = 17990000.0, l.currentPriceText = '17.990.000₫', l.originalPriceText = '', l.discountPercentageText = ''
