MERGE (l:Laptop {productId: '/laptop/dell-latitude-5350-ultra-7-165u-vpro-l5350165u16512w'}) SET l.name = 'dell-latitude-5350-ultra-7-165u-vpro-l5350165u16512w', l.url = 'https://www.thegioididong.com/laptop/dell-latitude-5350-ultra-7-165u-vpro-l5350165u16512w', l.description = 'Dell Latitude 5350 Ultra 7 165U (L5350-165U-16512W) là một chiếc laptop lý tưởng cho học sinh, sinh viên và nhân viên văn phòng nhờ sự kết hợp hoàn hảo giữa hiệu năng mạnh mẽ, thiết kế nhỏ gọn và độ bền bỉ ấn tượng. Chiếc laptop Dell này hứa hẹn mang đến trải nghiệm làm việc và học tập mượt mà, hiệu quả, đáp ứng tốt mọi nhu cầu hàng ngày. \"Chiến\" mọi tác vụ với sức mạnh từ Intel Core Ultra 7 Đắm chìm trong không gian hiển thị sắc nét Âm thanh sống động, bảo mật tối ưu Thiết kế mỏng nhẹ, độ bền vượt trội Kết nối đa dạng, thời lượng pin ấn tượng Dell Latitude 5350 Ultra 7 165U được trang bị bộ vi xử lý Intel Core Ultra 7 Meteor Lake - 165U với 12 nhân và 14 luồng, xung nhịp có thể đạt tối đa 4.9 GHz nhờ Turbo Boost. Cấu hình này cho phép máy xử lý mượt mà mọi tác vụ từ cơ bản như soạn thảo văn bản, duyệt web đến các ứng dụng nặng hơn như chỉnh sửa ảnh, video hay chạy các phần mềm văn phòng chuyên dụng. Card đồ họa tích hợp Intel Graphics cũng đủ sức đáp ứng nhu cầu giải trí nhẹ nhàng và hỗ trợ tốt cho công việc. Đi kèm với đó là 16 GB RAM LPDDR5X tốc độ 6400 MHz, đảm bảo khả năng đa nhiệm ấn tượng, cho phép bạn mở nhiều ứng dụng cùng lúc mà không lo giật lag. Ổ cứng 512 GB SSD NVMe PCIe Gen 4 không chỉ cung cấp không gian lưu trữ thoải mái cho tài liệu, hình ảnh, video mà còn giúp laptop khởi động nhanh chóng và truy xuất dữ liệu siêu tốc. Đặc biệt, bạn có thể dễ dàng nâng cấp ổ cứng lên tối đa 2 TB nếu có nhu cầu lưu trữ lớn hơn. Laptop học tập - văn phòng Dell Latitude 5350', l.launchYear = 2024, l.currentPrice = 29990000.0, l.currentPriceText = '29.990.000₫ *', l.originalPriceText = '31.990.000₫', l.discountPercentageText = '-6%'
