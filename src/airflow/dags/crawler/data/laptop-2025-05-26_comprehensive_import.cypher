MERGE (l:Laptop {productId: '/laptop/acer-swift-ai-sf14-51-53p9-ultra-5-nxj2ksv002'}) SET l.name = 'acer-swift-ai-sf14-51-53p9-ultra-5-nxj2ksv002', l.url = 'https://www.thegioididong.com/laptop/acer-swift-ai-sf14-51-53p9-ultra-5-nxj2ksv002', l.description = 'Phát triển những mẫu thiết bị thế hệ mới ngày càng thông minh hơn có thể nói đang là xu hướng toàn cầu hiện nay. Laptop Acer Swift AI SF14 51 53P9 Ultra 5 226V (NX.J2KSV.002) sở hữu kiểu dáng thanh lịch, gọn gàng, màn hình 2.8K tuyệt đẹp và hơn hết là sở hữu con chip Intel Ultra thế hệ 2 mạnh mẽ và ngày càng thông minh hơn cho mọi vấn đề công việc cá nhân. Thiết kế mỏng nhẹ, sang trọng, bản lề mở 180 độ Đa dạng cổng kết nối, thời lượng pin ấn tượng Đắm chìm trong không gian hiển thị sắc nét, sống động Tận hưởng âm thanh sống động, webcam sắc nét Sức mạnh \"AI\" ẩn mình bên trong chiếc laptop mỏng nhẹ Acer Swift AI sở hữu thiết kế tinh tế với độ dày chỉ 15.95 mm và khối lượng 1.26 kg, giúp bạn dễ dàng mang theo trong balo hoặc túi xách mà không gây cảm giác nặng nề, đối với những chuyến đi xa thì lại vô cùng lý tưởng. Lớp vỏ kim loại cao cấp không chỉ tăng thêm vẻ ngoài sang trọng mà còn đảm bảo độ bền bỉ, giúp chiếc laptop có thể chịu được áp lực từ môi trường làm việc hàng ngày. Thu hình chuẩn nét với QHD Webcam, tích hợp hơn khi không cần phải trang bị thêm bất cứ dụng cụ gì để làm việc trực tuyến thật hiệu quả. Nhận diện vân tay giúp truy cập thiết bị nhanh chóng chỉ qua một chạm cực đơn giản, hệ thống đèn nền bàn phím là giải pháp hoàn hảo mỗi khi cần thao tác công việc ở những nơi thiếu sáng. Thiết bị có đầy đủ các cổng kết nối cần thiết ở cả 2 bên máy như: HDMI, USB 3.2, Headphone/microphone combo và USB Type-C hỗ trợ giao tiếp hiệu quả với mọi thiết bị ngoại vi bạn cần', l.launchYear = 2024, l.currentPrice = 34990000.0, l.currentPriceText = '34.990.000₫', l.originalPriceText = '', l.discountPercentageText = ''
