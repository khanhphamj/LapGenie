MERGE (l:Laptop {productId: '/laptop/msi-modern-15-b12mo-i5-625vn'}) SET l.name = 'msi-modern-15-b12mo-i5-625vn', l.url = 'https://www.thegioididong.com/laptop/msi-modern-15-b12mo-i5-625vn', l.description = 'Laptop MSI Modern 15 B12MO i5 1235U (625VN) mang đam mê của bạn bắt nhịp với lối sống năng động hiện đại. Dù là bạn đang bận rộn trong văn phòng hay làm việc trên giảng đường, vi xử lý Intel Core Alder lake thế hệ mới cũng sẽ đáp ứng mọi nhu cầu của bạn. Tối giản, tinh tế trên từng góc máy Ổn định mọi công việc Hiển thị sống động và đa dạng nội dung Với phân khúc là một mẫu laptop học tập - văn phòng giá rẻ nhưng theo mình thấy thì em MSI Modern này vẫn sở hữu một vẻ ngoài khá đẹp mắt và có phần “cạnh tranh\" về gu thẩm mỹ khi so với những mẫu ultrabook ở phân khúc trên. Máy được phủ tông màu đen nhám trung tính, đường viền khung máy có thiết kế bo tròn mềm mại, tạo cảm giác khá dịu mắt cũng như hài hoà không gian nên mình có thể mang theo tới bất cứ đâu. Bản lề máy được thiết kế với kiểu ergolift khiến thiết bị có một độ nâng nhất định, đẩy cao hiệu suất gõ bàn phím và cũng hỗ trợ tản nhiệt tốt, hơn nữa mình có thể thoải mái mở gập bản lề 180 độ cho thích hợp với các yêu cầu sử dụng trong buổi họp hay trình bày ý tưởng. Laptop có khối lượng hơi đầm tay một chút là 1.7 kg nhưng theo mình thấy thì máy cũng không quá nặng đủ để bỏ gọn trong balo và mang theo xuyên suốt bên mình. Mọi thao tác gõ phím cũng được bổ trợ khá tốt cùng layout bàn phím Full size, với những bạn nào thuộc những khối ngành như kế toán, tài chính hay phải nhập số liệu nhiều thì đây chính xác là một sự trang bị cần thiết. Phím với độ nảy tốt và có sẵn đèn nền nên mình cũng yên tâm hơn trong những buổi chạy ', l.launchYear = 2023, l.currentPrice = 0.0, l.currentPriceText = '', l.originalPriceText = '', l.discountPercentageText = ''
