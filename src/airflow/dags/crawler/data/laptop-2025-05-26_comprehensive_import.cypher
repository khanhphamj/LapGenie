MERGE (l:Laptop {productId: '/laptop/lenovo-thinkbook-14-g6-i7-21kg00bqvn'}) SET l.name = 'lenovo-thinkbook-14-g6-i7-21kg00bqvn', l.url = 'https://www.thegioididong.com/laptop/lenovo-thinkbook-14-g6-i7-21kg00bqvn', l.description = 'Nếu bạn đang tìm kiếm một chiếc laptop học tập - văn phòng chuyên nghiệp, hiệu năng mạnh mẽ, thiết kế tinh tế nhưng vẫn hợp túi tiền thì laptop Lenovo ThinkBook 14 G6 i7 1355U (21KG00BQVN) không thể nằm ngoài \"danh sách lựa chọn\". Với cấu hình vượt trội, các công nghệ hiện đại và mức giá cạnh tranh, đây là công cụ hỗ trợ không thể thiếu cho học sinh, sinh viên và nhân viên văn phòng. Hiệu năng ổn định, xử lý mượt mà mọi tác vụ Màn hình sắc nét, hiển thị sống động Âm thanh sống động, webcam sắc nét và các tính năng hỗ trợ khác Thiết kế mỏng nhẹ, độ bền cao Cổng kết nối đa dạng, thời lượng pin ổn định Sản phẩm được trang bị bộ vi xử lý Intel Core i7 1355U thiết kế với 10 nhân 12 luồng, cùng khả năng ép xung lên đến 5.0 GHz nhờ công nghệ Turbo Boost. Nhờ đó, máy xử lý mượt mà mọi tác vụ từ cơ bản đến phức tạp. Dù bạn cần làm việc trên các ứng dụng văn phòng như Word, Excel, PowerPoint,... thực hiện lập trình hay chỉnh sửa đồ họa trên Figma, Adobe,... Lenovo ThinkBook 14 đều đáp ứng tốt. Card đồ họa tích hợp Intel Iris Xe Graphics tối ưu hiệu năng xử lý hình ảnh, hỗ trợ người dùng chỉnh sửa thiết kế trên Photoshop, AI hoặc render video hiệu quả mà vẫn đảm bảo mượt mà. Thêm vào đó, bạn hoàn toàn có thể giải trí thoải mái với những con game đình đám như: LOL, Valorant, FO4,... sau những giây phút làm việc căng thẳng. Máy sở hữu RAM 16 GB mang đến khả năng đa nhiệm vượt trội. Người dùng có thể mở hàng chục ứng dụng, chuyển đổi giữa các cửa sổ làm việc mà không lo giật lag. Khi cần', l.launchYear = 2024, l.currentPrice = 21590000.0, l.currentPriceText = '21.590.000₫', l.originalPriceText = '22.990.000₫', l.discountPercentageText = '-6%'
