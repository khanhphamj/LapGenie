MERGE (l:Laptop {productId: '/laptop/msi-titan-18-hx-ai-a2xwig-ultra-9-090vn'}) SET l.name = 'msi-titan-18-hx-ai-a2xwig-ultra-9-090vn', l.url = 'https://www.thegioididong.com/laptop/msi-titan-18-hx-ai-a2xwig-ultra-9-090vn', l.description = 'Laptop MSI Titan 18 HX AI A2XWIG Ultra 9 285HX (090VN) là sự kết hợp hoàn hảo giữa công nghệ đột phá và thiết kế cao cấp, mang đến trải nghiệm gaming và sáng tạo không giới hạn. Với sức mạnh từ vi xử lý Intel Core Ultra 9 kết hợp cùng GPU NVIDIA RTX 5000 series hiệu suất đỉnh cao, giúp máy xử lý mọi tác vụ từ gaming chuyên nghiệp đến đồ họa AI. Màn hình 18 inch UHD+ với tần số quét 120 Hz lý tưởng cho mọi game thủ và nhà sáng tạo bứt phá mọi giới hạn. Thiết kế đẳng cấp - Biểu tượng của sức mạnh và phong cách Kết nối toàn diện - Sẵn sàng cho mọi nhu cầu Chinh phục mọi tác vụ với hiệu suất đỉnh cao Mang đến tốc độ ấn tượng với bộ nhớ khủng Trải nghiệm hình ảnh và âm thanh chuyên nghiệp - Chân thực đến từng chi tiết Laptop MSI Titan sở hữu thiết kế mạnh mẽ với vỏ kim loại cao cấp, giúp tăng cường độ bền và mang lại cảm giác sang trọng. Nắp máy được tô điểm bằng logo rồng đỏ, biểu tượng của sức mạnh gaming đẳng cấp nhà MSI. Hệ thống LED Mystic Light RGB chạy dọc thân máy có thể tùy chỉnh theo phong cách cá nhân, tạo hiệu ứng ánh sáng sống động. Bàn phím cơ CHERRY MX với đèn LED RGB Per-Key mang lại trải nghiệm gõ phím chính xác, phản hồi nhanh, đồng thời cho phép game thủ tùy chỉnh màu sắc và hiệu ứng ánh sáng theo sở thích. Các phím bấm có độ bền cao, cảm giác nhấn êm ái, giúp gia tăng tốc độ phản xạ trong các tựa game cạnh tranh. Touchpad kính cao cấp với hỗ trợ đa điểm mang đến trải nghiệm di chuột mượt mà, thao tác chính xác và nhanh nhạy. Bề mặt kính giúp giảm ma sát, tạo cả', l.launchYear = 2025, l.currentPrice = 149990000.0, l.currentPriceText = '149.990.000₫', l.originalPriceText = '', l.discountPercentageText = ''
