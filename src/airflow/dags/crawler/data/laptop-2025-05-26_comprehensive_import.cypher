MERGE (l:Laptop {productId: '/laptop/asus-rog-strix-scar-18-g835lw-ultra-9-sa172w'}) SET l.name = 'asus-rog-strix-scar-18-g835lw-ultra-9-sa172w', l.url = 'https://www.thegioididong.com/laptop/asus-rog-strix-scar-18-g835lw-ultra-9-sa172w', l.description = 'Laptop Asus ROG Strix SCAR 18 G835LW Ultra 9 275HX (SA172W) là cỗ máy chiến game tối thượng, được thiết kế dành riêng cho các game thủ chuyên nghiệp và những người dùng đòi hỏi hiệu năng đỉnh cao trong công việc sáng tạo. Với sức mạnh vượt trội, màn hình siêu mượt và thiết kế đậm chất gaming, chiếc laptop này hứa hẹn mang đến trải nghiệm tuyệt vời trong mọi tác vụ. Đây không chỉ là một chiếc laptop, mà là một trạm chiến lược di động, sẵn sàng chinh phục mọi thử thách. \"Quái vật hiệu năng\" ẩn mình trong thiết kế gaming hầm hố Đắm chìm trong thế giới hình ảnh sắc nét và sống động Âm thanh vòm sống động và kết nối toàn diện Thiết kế hầm hố, đậm chất gaming và độ bền ấn tượng Kết nối đa dạng và thời lượng pin ổn định ROG Strix SCAR 18 G835LW (SA172W) được trang bị bộ vi xử lý Intel Core Ultra 9 Arrow Lake 275HX với 24 nhân và 24 luồng, tốc độ xung nhịp lên đến 5.40 GHz nhờ Turbo Boost. Cùng với đó là NPU Intel AI Boost, mang lại hiệu năng xử lý AI vượt trội với 13 TOPS, giúp tăng tốc các ứng dụng sáng tạo và tối ưu hóa trải nghiệm gaming. Card đồ họa rời NVIDIA GeForce RTX 5080 16 GB biến mọi tựa game AAA trở nên mượt mà ở thiết lập đồ họa cao nhất. Với laptop gaming này, bạn sẽ không phải lo lắng về việc giật lag hay drop FPS. Bộ nhớ RAM 64 GB DDR5 tốc độ 5600 MHz đảm bảo khả năng đa nhiệm mượt mà, cho phép bạn mở hàng loạt ứng dụng cùng lúc mà không gặp bất kỳ trở ngại nào. Hai ổ cứng SSD 2 TB NVMe PCIe Gen 4x4 cung cấp không gian lưu trữ rộng lớn và tốc độ truy xuất dữ liệu ', l.launchYear = 2025, l.currentPrice = 121990000.0, l.currentPriceText = '121.990.000₫', l.originalPriceText = '', l.discountPercentageText = ''
MATCH (l:Laptop {productId: '/laptop/asus-rog-strix-scar-18-g835lw-ultra-9-sa172w'}) SET l.cpuModel = 'Intel Core Ultra 9 Arrow Lake - 275HX', l.cpuCores = 24, l.cpuThreads = 24, l.cpuBaseSpeedGHz = 2.7, l.cpuMaxSpeedText = 'Turbo Boost 5.40 GHz'
