MERGE (l:Laptop {productId: '/laptop/lenovo-ideapad-slim-5-oled-14irh10-i5-83hr005yvn'}) SET l.name = 'lenovo-ideapad-slim-5-oled-14irh10-i5-83hr005yvn', l.url = 'https://www.thegioididong.com/laptop/lenovo-ideapad-slim-5-oled-14irh10-i5-83hr005yvn', l.description = 'Laptop Lenovo IdeaPad Slim 5 OLED 14IRH10 i5 13420H (83HR005YVN) là sự lựa chọn lý tưởng cho học sinh, sinh viên và nhân viên văn phòng nhờ thiết kế mỏng nhẹ, màn hình OLED sống động và hiệu năng ổn định. Chiếc laptop này mang đến trải nghiệm làm việc và giải trí tuyệt vời, đáp ứng mọi nhu cầu hàng ngày của bạn. Đây là một chiếc laptop đáng mua trong phân khúc, mang lại giá trị vượt trội cho người dùng. Hiệu năng mạnh mẽ cho công việc và học tập Màn hình OLED sống động, sắc nét đến từng chi tiết Âm thanh Dolby Audio và các tính năng hỗ trợ khác Thiết kế mỏng nhẹ, độ bền chuẩn quân đội Cổng kết nối đa dạng, thời lượng pin ấn tượng Lenovo IdeaPad Slim 5 OLED 14IRH10 được trang bị bộ vi xử lý Intel Core i5 Raptor Lake - 13420H với 8 nhân và 12 luồng, tốc độ xung nhịp lên đến 4.6 GHz nhờ Turbo Boost. Với cấu hình này, máy có thể xử lý mượt mà các tác vụ văn phòng, học tập và thậm chí là chơi các tựa game eSport ở mức cài đặt phù hợp. Card tích hợp Intel UHD Graphics cũng đáp ứng tốt nhu cầu đồ họa cơ bản. Bộ nhớ RAM 16 GB DDR5 với tốc độ Bus 5600 MHz giúp laptop chạy đa nhiệm hiệu quả, bạn có thể mở nhiều ứng dụng cùng lúc mà không lo bị giật lag. Ổ cứng 1 TB SSD NVMe PCIe Gen 4 cho tốc độ đọc/ghi dữ liệu nhanh chóng, giúp khởi động máy và mở ứng dụng chỉ trong tích tắc. Màn hình OLED 14 inch của Lenovo IdeaPad có độ phân giải WUXGA (1920 x 1200), mang đến hình ảnh sắc nét và sống động. Độ phủ màu 100% DCI-P3 giúp tái tạo màu sắc chính xác, chân thực, rất lý tưởng cho các công vi', l.launchYear = 2023, l.currentPrice = 19690000.0, l.currentPriceText = '19.690.000₫ *', l.originalPriceText = '21.990.000₫', l.discountPercentageText = '-10%'
